# Cursor IDE
.cursor/

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Checkpoints / weights (large binary files, not tracked)
checkpoints*/
*.pt
*.pt.tmp

# Local V12 module registry + compose packs (weights, cards, index)
v12_registry/
packed_v12/

# HF release bundle (weights on Hugging Face; regenerate via scripts/export_hf_release.py)
hf_release/*.pt
hf_release/__pycache__/

# Release round bundles/checkpoints copied for shipping (manifest is tracked, blobs are not)
releases/**/*.pt
releases/**/*.tgz

# Caches
.cache/
*cache*/

# Local training corpora (FineWeb shards etc.; download via scripts/download_fineweb_shards.sh)
data/


.env

log_copy.sh
logs/remote_medium_pam_v3.log

# Per-example behavioral dumps (prompts + logits). Tracked *_behavior.json
# files keep metadata + aggregates only. Full rows are opt-in via
# run_memory_behavioral.py --keep-rows and must not be committed uncompressed.
logs/memory_probes/*_behavior.rows.json
logs/memory_probes/*_behavior.rows.json.gz

# Personal learning notebooks (not part of the project)
learn/

node_modules/