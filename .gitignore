# Cursor IDE
.cursor/

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Checkpoints / weights (large binary files, not tracked)
checkpoints*/
# Local-box symlinks to d_drive (e.g. checkpoints_v13_sempty -> /media/gowrav/d_drive/...):
# a symlink is not a directory, so 'checkpoints*/' misses it. Never commit
# them: on the 6000 these are real folders and the d_drive path does not exist.
/checkpoints*
*.pt
*.pt.tmp

# Local V12 module registry + compose packs (weights, cards, index)
v12_registry/
packed_v12/

# HF release bundle (weights on Hugging Face; regenerate via scripts/export_hf_release.py)
hf_release/*.pt
hf_release/__pycache__/

# Release round bundles/checkpoints copied for shipping (manifest is tracked, blobs are not)
releases/**/*.pt
releases/**/*.tgz

# Caches
.cache/
*cache*/

# Local training corpora (FineWeb shards etc.; download via scripts/download_fineweb_shards.sh)
data/


.env

log_copy.sh
logs/remote_medium_pam_v3.log

# Per-example behavioral dumps (prompts + logits). Tracked JSON keeps
# metadata + aggregates only. Full rows are opt-in via --keep-rows.
**/*_behavior.rows.json
**/*_behavior.rows.json.gz

# Personal learning notebooks (not part of the project)
learn/

node_modules/
# Runtime state rewritten by watchers (never a code change)
v13/tmp/omp_cron_state.json

# Throwaway/debug scripts under v*/tmp/ need no commit (AGENTS.md); files
# already tracked there stay tracked, new ones need `git add -f`.
v*/tmp/*

# Launcher exit-code markers (one per run, regenerated)
logs/*.exit
